# ===========================================
# 配置文件模板
# 复制此文件为 application-dev.yml 并填入实际配置
# 注意：此文件可以提交到 Git，但 application-dev.yml 不应该提交
# ===========================================

server:
  port: ${port:8088}

spring:
  application:
    name: shayuvideo-nacos
  datasource: # 数据源的相关配置
    type: com.zaxxer.hikari.HikariDataSource
    driver-class-name: com.mysql.jdbc.Driver
    # 使用环境变量，不提供默认值，强制必须设置环境变量
    url: jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}  # 必须通过环境变量提供，无默认值
    hikari:
      connection-timeout: 30000
      minimum-idle: 5
      maximum-pool-size: 20
      auto-commit: true
      idle-timeout: 600000
      pool-name: DataSourceHikariCP
      max-lifetime: 18000000
      connection-test-query: SELECT 1
  # Redis 配置
  redis:
    host: ${REDIS_HOST}
    port: ${REDIS_PORT:6379}  # 端口可以使用默认值
    database: ${REDIS_DATABASE:0}
    password: ${REDIS_PASSWORD}  # 密码必须通过环境变量提供
  # Mongodb 配置
  data:
    mongodb:
      uri: mongodb://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DATABASE}
      database: ${MONGODB_DATABASE}
  # Rabbitmq 配置
  rabbitmq:
    host: ${RABBITMQ_HOST}
    port: ${RABBITMQ_PORT:5672}
    username: ${RABBITMQ_USERNAME}
    password: ${RABBITMQ_PASSWORD}  # 必须通过环境变量提供
    virtual-host: ${RABBITMQ_VHOST}
  # Nacos 配置
  cloud:
    nacos:
      discovery:
        server-addr: ${NACOS_SERVER_ADDR}

# 打开监控
management:
  endpoint:
    web:
      exposure:
        include: '*'

# MinIO 配置
minio:
  endpoint: ${MINIO_ENDPOINT}
  fileHost: ${MINIO_FILE_HOST}
  bucketName: ${MINIO_BUCKET_NAME}
  accessKey: ${MINIO_ACCESS_KEY}
  secretKey: ${MINIO_SECRET_KEY}  # 必须通过环境变量提供
  imgSize: ${MINIO_IMG_SIZE:1024}
  fileSize: ${MINIO_FILE_SIZE:1024}
